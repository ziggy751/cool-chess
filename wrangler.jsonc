{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cool-chess",
  "main": "server/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/socket"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "LOBBY", "class_name": "ChessLobby"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["ChessLobby"]}
  ]
}
